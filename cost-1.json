          }
        ]
      },
      {
        "name": "node_support",
        "label": "k · Node başına support maliyeti",
        "type": "constant",
        "hide": 2,
        "query": "50",
        "current": {
          "text": "50",
          "value": "50"
        },
        "options": [
          {
