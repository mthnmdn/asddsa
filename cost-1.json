      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "Europe/Istanbul",
  "title": "K8s Envanter",
  "uid": "k8s-envanter",
  "version": 13,
  "weekStart": ""
}
