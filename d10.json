          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "100 * count by (node) (kube_pod_info{node=~\"$node\", node!=\"\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)) / sum by (node) (kube_node_status_allocatable{resource=\"pods\", node=~\"$node\"})",
          "legendFormat": "{{node}}"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "openshift",
    "kubernetes",
    "node",
    "pod",
    "capacity"
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "cluster",
        "label": "Cluster",
        "query": "prometheus",
        "regex": "/^k8s.*/",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "options": []
      },
      {
        "type": "query",
        "name": "role",
        "label": "Node Rolü",
        "description": "node-role.kubernetes.io/<rol> label'ından gelir (kube_node_role).",
        "datasource": {
          "type": "prometheus",
          "uid": "${cluster}"
        },
        "definition": "label_values(kube_node_role, role)",
        "query": {
          "query": "label_values(kube_node_role, role)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "regex": "/^(physical-worker|router|control-plane)$/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": []
      },
      {
        "type": "query",
        "name": "node",
        "label": "Node",
        "datasource": {
          "type": "prometheus",
          "uid": "${cluster}"
        },
        "definition": "label_values(kube_node_role{role=~\"$role\"}, node)",
        "query": {
          "query": "label_values(kube_node_role{role=~\"$role\"}, node)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "regex": "",
        "options": [],
        "description": "Seçili rol(ler)deki node'lar. All = o rollerdeki tüm node'lar."
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "OpenShift - Node & Pod İlişkisi",
