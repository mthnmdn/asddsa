{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Özet",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Node Sayısı",
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${cluster}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "count(kube_node_info{node=~\"$node\"})",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pod / Kapasite",
      "id": 2,
      "description": "Aktif pod (Succeeded/Failed hariç), allocatable pod kapasitesi ve kalan slot.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 3,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${cluster}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "count(kube_pod_info{node=~\"$node\", node!=\"\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1))",
          "legendFormat": "Aktif Pod",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "sum(kube_node_status_allocatable{resource=\"pods\", node=~\"$node\"})",
          "legendFormat": "Kapasite",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "sum(kube_node_status_allocatable{resource=\"pods\", node=~\"$node\"}) - count(kube_pod_info{node=~\"$node\", node!=\"\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1))",
          "legendFormat": "Kalan Slot",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Doluluk",
      "id": 3,
      "description": "Pod: aktif pod / pod kapasitesi. CPU ve Bellek: pod request toplamı / allocatable.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${cluster}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "100 * count(kube_pod_info{node=~\"$node\", node!=\"\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)) / sum(kube_node_status_allocatable{resource=\"pods\", node=~\"$node\"})",
          "legendFormat": "Pod",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "100 * sum(kube_pod_container_resource_requests{resource=\"cpu\", node=~\"$node\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)) / sum(kube_node_status_allocatable{resource=\"cpu\", node=~\"$node\"})",
          "legendFormat": "CPU",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "100 * sum(kube_pod_container_resource_requests{resource=\"memory\", node=~\"$node\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)) / sum(kube_node_status_allocatable{resource=\"memory\", node=~\"$node\"})",
          "legendFormat": "Bellek",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "N-1 Doluluk",
      "id": 4,
      "description": "Seçili node'lardan en büyüğü devre dışı kalırsa kalan node'lardaki doluluk (bakım/upgrade/arıza senaryosu).",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${cluster}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "100 * count(kube_pod_info{node=~\"$node\", node!=\"\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)) / (sum(kube_node_status_allocatable{resource=\"pods\", node=~\"$node\"}) - max(kube_node_status_allocatable{resource=\"pods\", node=~\"$node\"}))",
          "legendFormat": "Pod",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "100 * sum(kube_pod_container_resource_requests{resource=\"cpu\", node=~\"$node\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)) / (sum(kube_node_status_allocatable{resource=\"cpu\", node=~\"$node\"}) - max(kube_node_status_allocatable{resource=\"cpu\", node=~\"$node\"}))",
          "legendFormat": "CPU",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "100 * sum(kube_pod_container_resource_requests{resource=\"memory\", node=~\"$node\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)) / (sum(kube_node_status_allocatable{resource=\"memory\", node=~\"$node\"}) - max(kube_node_status_allocatable{resource=\"memory\", node=~\"$node\"}))",
          "legendFormat": "Bellek",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Çıkarılabilir physical-worker Node",
      "id": 5,
      "description": "Rol/node filtresinden bağımsız, yalnızca physical-worker node'ları. Son 30 günün tepe kullanımı, hedef doluluğu ($hedef%) aşmadan kaç node çıkarılabileceği. Net = Pod, CPU ve Bellek sonuçlarının en küçüğü. DaemonSet pod'ları dahildir.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${cluster}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "clamp_min(min(label_replace(floor(($hedef / 100 * sum(kube_node_status_allocatable{resource=\"pods\"} and on (node) kube_node_role{role=\"physical-worker\"}) - max_over_time((count(kube_pod_info{node!=\"\"} and on (node) kube_node_role{role=\"physical-worker\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)))[30d:1h])) / avg(kube_node_status_allocatable{resource=\"pods\"} and on (node) kube_node_role{role=\"physical-worker\"})), \"r\", \"pod\", \"\", \"\") or label_replace(floor(($hedef / 100 * sum(kube_node_status_allocatable{resource=\"cpu\"} and on (node) kube_node_role{role=\"physical-worker\"}) - max_over_time((sum(kube_pod_container_resource_requests{resource=\"cpu\"} and on (node) kube_node_role{role=\"physical-worker\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)))[30d:1h])) / avg(kube_node_status_allocatable{resource=\"cpu\"} and on (node) kube_node_role{role=\"physical-worker\"})), \"r\", \"cpu\", \"\", \"\") or label_replace(floor(($hedef / 100 * sum(kube_node_status_allocatable{resource=\"memory\"} and on (node) kube_node_role{role=\"physical-worker\"}) - max_over_time((sum(kube_pod_container_resource_requests{resource=\"memory\"} and on (node) kube_node_role{role=\"physical-worker\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)))[30d:1h])) / avg(kube_node_status_allocatable{resource=\"memory\"} and on (node) kube_node_role{role=\"physical-worker\"})), \"r\", \"mem\", \"\", \"\")), 0)",
          "legendFormat": "Net",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "clamp_min(floor(($hedef / 100 * sum(kube_node_status_allocatable{resource=\"pods\"} and on (node) kube_node_role{role=\"physical-worker\"}) - max_over_time((count(kube_pod_info{node!=\"\"} and on (node) kube_node_role{role=\"physical-worker\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)))[30d:1h])) / avg(kube_node_status_allocatable{resource=\"pods\"} and on (node) kube_node_role{role=\"physical-worker\"})), 0)",
          "legendFormat": "Pod",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "clamp_min(floor(($hedef / 100 * sum(kube_node_status_allocatable{resource=\"cpu\"} and on (node) kube_node_role{role=\"physical-worker\"}) - max_over_time((sum(kube_pod_container_resource_requests{resource=\"cpu\"} and on (node) kube_node_role{role=\"physical-worker\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)))[30d:1h])) / avg(kube_node_status_allocatable{resource=\"cpu\"} and on (node) kube_node_role{role=\"physical-worker\"})), 0)",
          "legendFormat": "CPU",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "clamp_min(floor(($hedef / 100 * sum(kube_node_status_allocatable{resource=\"memory\"} and on (node) kube_node_role{role=\"physical-worker\"}) - max_over_time((sum(kube_pod_container_resource_requests{resource=\"memory\"} and on (node) kube_node_role{role=\"physical-worker\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)))[30d:1h])) / avg(kube_node_status_allocatable{resource=\"memory\"} and on (node) kube_node_role{role=\"physical-worker\"})), 0)",
          "legendFormat": "Bellek",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Node Detayı",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 101,
      "panels": []
    },
    {
      "type": "table",
      "title": "Node Kapasite Tablosu",
      "description": "Node başına pod, CPU request ve bellek request doluluğu. '30g Tepe Pod %' son 30 günün en yüksek pod doluluğu; anlık değeri düşük ama tepesi yüksek node'lar çıkarma adayı değildir.",
      "id": 6,
      "gridPos": {
        "h": 13,
        "w": 16,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${cluster}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*%$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 70
                    },
                    {
                      "color": "red",
                      "value": 85
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "NotReady",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Ready",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Node"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Bu node'un pod'larını göster",
                    "url": "/d/${__dashboard.uid}?${cluster:queryparam}&${role:queryparam}&var-node=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Pod",
            "Kapasite",
            "Boş Slot"
          ]
        },
        "sortBy": [
          {
            "displayName": "Pod %",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "count by (node) (kube_pod_info{node=~\"$node\", node!=\"\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"pods\", node=~\"$node\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "100 * count by (node) (kube_pod_info{node=~\"$node\", node!=\"\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)) / sum by (node) (kube_node_status_allocatable{resource=\"pods\", node=~\"$node\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"pods\", node=~\"$node\"}) - count by (node) (kube_pod_info{node=~\"$node\", node!=\"\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "sum by (node) (kube_node_status_condition{condition=\"Ready\", status=\"true\", node=~\"$node\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "max_over_time((100 * count by (node) (kube_pod_info{node=~\"$node\", node!=\"\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)) / sum by (node) (kube_node_status_allocatable{resource=\"pods\", node=~\"$node\"}))[30d:1h])",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "100 * sum by (node) (kube_pod_container_resource_requests{resource=\"cpu\", node=~\"$node\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)) / sum by (node) (kube_node_status_allocatable{resource=\"cpu\", node=~\"$node\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "expr": "100 * sum by (node) (kube_pod_container_resource_requests{resource=\"memory\", node=~\"$node\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)) / sum by (node) (kube_node_status_allocatable{resource=\"memory\", node=~\"$node\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "node": 0,
              "Value #E": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #D": 4,
              "Value #C": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8
            },
            "renameByName": {
              "node": "Node",
              "Value #E": "Ready",
              "Value #A": "Pod",
              "Value #B": "Kapasite",
              "Value #D": "Boş Slot",
              "Value #C": "Pod %",
              "Value #F": "30g Tepe Pod %",
              "Value #G": "CPU Req %",
              "Value #H": "Bellek Req %"
            }
          }
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Doluluk Dağılımı (Histogram)",
      "description": "Pod doluluk oranı aralıklarına göre node sayısı. Seçili rol/node filtresine uyar.",
      "id": 12,
      "gridPos": {
        "h": 13,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${cluster}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "displayName": "${__field.displayName}"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
